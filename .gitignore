# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pdm-build/

# Virtual environments and environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Jupyter / notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Test and coverage reports
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local databases and DuckDB files
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.db
*.sqlite
*.sqlite3

# PostgreSQL / spatial DB local files (common for GIS tooling)
*.pgpass
*.psql_history

# Local GIS data and generated outputs
# Keep source datasets tracked intentionally; ignore generated working files only.
output/
outputs/
exports/
results/
cache/
caches/
tmp/
temp/
scratch/
artifacts/

# Common geospatial working files / GDAL cache noise
*.aux.xml
*.ovr
*.msk
*.lock
*.qpj
*.prj
*.vrt
*.tif.aux.xml
*.tiff.aux.xml
*.png.aux.xml
*.jp2.aux.xml

# Raster/vector metadata often generated locally
*.cpg
*.shx
*.dbf
*.qix
*.sbn
*.sbx
*.xml

# GeoParquet / parquet caches from local analysis
*.parquet
*.parquet.tmp

# Project-specific working files
logs/
.log
*.log

# Optional: keep machine-specific notebooks or scripts local
local_*
scratch_*

# If you keep a local GeoJSON/GPKG directory for experimentation, ignore it explicitly
# (uncomment if needed)
# local_gis/
# *.gpkg
# *.geojson
